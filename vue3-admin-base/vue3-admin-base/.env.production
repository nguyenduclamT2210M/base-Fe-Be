# ============================================================
# FILE: .env.production
# TÁC DỤNG: Biến môi trường khi chạy `npm run build` (bản đưa lên server).
# CÁCH DÙNG: Sửa VITE_API_URL thành địa chỉ backend production. Luôn tắt mock.
# ============================================================
VITE_APP_TITLE=Admin Base
VITE_API_URL=https://api.your-domain.com/api
VITE_API_TIMEOUT=15000
VITE_USE_MOCK=false
