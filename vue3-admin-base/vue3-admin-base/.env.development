# ============================================================
# FILE: .env.development
# TÁC DỤNG: Biến môi trường khi chạy `npm run dev`.
# CÁCH DÙNG:
#   - Chỉ biến có tiền tố VITE_ mới đọc được trong code: import.meta.env.VITE_API_URL
#   - VITE_USE_MOCK=true  → dùng dữ liệu giả trong src/mocks (không cần backend)
#   - VITE_USE_MOCK=false → gọi backend thật theo VITE_API_URL
#   - Không commit thông tin bí mật (secret key) vào file .env: code frontend ai cũng xem được.
# ============================================================
VITE_APP_TITLE=Admin Base
VITE_API_URL=http://localhost:5000/api
VITE_API_TIMEOUT=15000
VITE_USE_MOCK=true
